# Runtime secrets belong in private environment configuration, never browser variables.
MONGODB_URI=
MONGODB_DATABASE=ontara
ONTARA_INTERNAL_TOKEN=
ONTARA_SESSION_SECRET=
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://your-web-service.onrender.com
DEMO_PORTAL_BASE_URL=https://your-demo-portals.onrender.com
# An executor origin derives /internal/v1/run. A nonblank full URL below overrides it.
ONTARA_EXECUTOR_BASE_URL=
ONTARA_AGENT_DISPATCH_URL=
