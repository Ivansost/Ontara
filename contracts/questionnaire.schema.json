            "select",
            "text",
            "textarea",
            "date"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
